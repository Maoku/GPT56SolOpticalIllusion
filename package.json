{
  "name": "gpt56-sol-optical-illusion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --project=ui-desktop --project=ui-mobile",
    "test:e2e:spatial": "playwright test --project=spatial-chromium",
    "verify:size": "node scripts/check-build-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion@5.0.7": "5.0.12",
    "brace-expansion@1.1.16": "1.1.21",
    "browserslist@4.28.6": "4.28.7",
    "js-yaml@4.3.0": "4.3.2",
    "nanoid@3.3.16": "3.3.18",
    "postcss@8.5.21": "8.5.23",
    "source-map-js@1.2.1": "1.2.2"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
